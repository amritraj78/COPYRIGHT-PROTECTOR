{
  "name": "COPYRIGHT PROTECTOR",
  "description": "High-performance Telegram Anti-Copyright & DMCA Protection Bot using Pyrogram",
  "repository": "https://github.com/amritraj78/COPYRIGHT-PROTECTOR",
  "keywords": ["telegram", "pyrogram", "copyright", "dmca", "anti-leak", "bot"],
  "env": {
    "API_ID": {
      "description": "Telegram API ID from my.telegram.org",
      "value": "6435225",
      "required": true
    },
    "API_HASH": {
      "description": "Telegram API Hash from my.telegram.org",
      "value": "4e984ea35f854762dcde906dce426c2d",
      "required": true
    },
    "BOT_TOKEN": {
      "description": "Telegram Bot Token from @BotFather",
      "required": true
    },
    "BOT_USERNAME": {
      "description": "Bot Username without @",
      "required": true
    },
    "OWNER_ID": {
      "description": "Your Telegram User ID (Owner)",
      "required": true
    },
    "LOGGER_ID": {
      "description": "Log Group / Channel ID (e.g. -100xxx)",
      "required": false
    },
    "MONGO_URL": {
      "description": "MongoDB Connection URI",
      "required": true
    },
    "PORT": {
      "description": "HTTP Port for Web Health Checks",
      "value": "8000",
      "required": false
    }
  },
  "formation": {
    "web": {
      "quantity": 1
    }
  },
  "stack": "container"
}
